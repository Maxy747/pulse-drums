<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pulse — Drum control" Width="1170" Height="1000" MinWidth="970" MinHeight="720" Background="#101211" Foreground="#F0F2E9" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#C5F36B"/>
    <SolidColorBrush x:Key="ThemeGreen" Color="#C5F36B"/>
    <SolidColorBrush x:Key="ThemeRed" Color="#F36B76"/>
    <SolidColorBrush x:Key="ThemeBlue" Color="#6BB6F3"/>
    <Style x:Key="ThemeDot" TargetType="Button">
      <Setter Property="Width" Value="29"/><Setter Property="Height" Value="29"/><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="5"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Ring" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="15" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="#343B30"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#EEF0E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF0E8"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#92998E"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#92998E"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#242923"/><Setter Property="Foreground" Value="#E7EBDD"/><Setter Property="BorderBrush" Value="#363D31"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#C5F36B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#C5F36B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EAF0E4"/><Setter Property="Background" Value="#282F23"/><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#282F23" CornerRadius="5" BorderBrush="#46513A" BorderThickness="1"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Foreground="#A5B497"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,3,26,3"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#242923" BorderBrush="#46513A" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EAF0E4"/><Setter Property="Background" Value="#242923"/><Setter Property="Padding" Value="9,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#46513A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#3A4431" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D2D9CB"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,6,0,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="32" Height="18" Background="#373D33" CornerRadius="9" Margin="0,0,10,0"><Ellipse x:Name="Knob" Width="12" Height="12" Fill="#92998E" HorizontalAlignment="Left" Margin="3,0"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#C5F36B"/><Setter TargetName="Knob" Property="Fill" Value="#1A2712"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="20"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Foreground" Value="#C5F36B"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="0,4"><Border Background="#343B30" Height="3" VerticalAlignment="Center" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#C5F36B" Height="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="13" Height="13" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#C5F36B"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#101211">
    <Grid Margin="28,22,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="36" Height="36" Margin="0,0,11,0"><Canvas Width="64" Height="64"><Path Stroke="#C5F36B" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 15,43 L 9,56 M 49,43 L 55,56"/><Ellipse Canvas.Left="9" Canvas.Top="4" Width="46" Height="46" Fill="#172010" Stroke="#C5F36B" StrokeThickness="4"/><Ellipse Canvas.Left="15" Canvas.Top="10" Width="34" Height="34" Stroke="#C5F36B" StrokeThickness="1"/><Path Stroke="#C5F36B" StrokeThickness="3" Data="M 32,35 L 32,52"/><Rectangle Canvas.Left="27" Canvas.Top="29" Width="10" Height="9" RadiusX="2" RadiusY="2" Fill="#C5F36B"/><Rectangle Canvas.Left="26" Canvas.Top="49" Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#C5F36B"/></Canvas></Viewbox><TextBlock Text="pulse" FontSize="27" FontWeight="Bold"/><TextBlock Text="DRUM CONTROL" Style="{StaticResource Caption}" Margin="18,13,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="GreenThemeButton" Style="{StaticResource ThemeDot}" ToolTip="Green theme" AutomationProperties.Name="Green theme"><Ellipse Fill="{StaticResource ThemeGreen}"/></Button>
          <Button x:Name="RedThemeButton" Style="{StaticResource ThemeDot}" ToolTip="Red theme" AutomationProperties.Name="Red theme"><Ellipse Fill="{StaticResource ThemeRed}"/></Button>
          <Button x:Name="BlueThemeButton" Style="{StaticResource ThemeDot}" ToolTip="Blue theme" AutomationProperties.Name="Blue theme"><Ellipse Fill="{StaticResource ThemeBlue}"/></Button>
        </StackPanel>
        <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" Background="#1D241A" CornerRadius="16" Padding="12,8" Margin="12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#B7A26B" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Looking for your drums" FontSize="11" Foreground="#C6D5BA"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,20,0,18">
        <StackPanel><TextBlock Text="Your kit. Your rhythm." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Eight pieces. One instrument." Style="{StaticResource Muted}" Margin="1,6,0,0"/></StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="SESSION HITS" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock x:Name="HitCount" Text="0" FontFamily="Consolas" FontSize="30" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button x:Name="KitViewButton" Content="Kit view" Padding="12,6"/><Button x:Name="ClassicViewButton" Content="Classic controls" Padding="12,6" Margin="6,0,0,0" Background="Transparent"/></StackPanel><Button x:Name="SetupAllButton" Content="Set up my kit" HorizontalAlignment="Right" Padding="12,6"/></Grid>
          <ContentControl x:Name="KitHost"/>
          <UniformGrid x:Name="PadsGrid" Rows="2" Columns="4" Margin="-5,0,-5,0" Visibility="Collapsed"/>
          <Border x:Name="SetupPanel" Visibility="Collapsed" Background="#1E2C20" BorderBrush="#61774A" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="SetupTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SetupHint" TextWrapping="Wrap" Foreground="#BBCDBB" Margin="0,6,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="SetupUndo" Content="Undo last part" Margin="0,0,8,0"/><Button x:Name="SetupCancel" Content="Cancel setup" Background="Transparent"/></StackPanel></StackPanel></Border>
          <Border Background="#181C17" BorderBrush="#2B3227" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="OUTPUT" Style="{StaticResource Caption}"/><TextBlock x:Name="AudioStatus" Grid.Column="1" Text="Stereo sample engine" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="10,0,0,0"/></Grid>

              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AudioDeviceCombo" AutomationProperties.Name="Audio output device"/><Button x:Name="AsioPanelButton" Grid.Column="1" Content="ASIO settings" Margin="8,0,0,0" Padding="9,5" ToolTip="Open the driver panel to change its buffer size"/><Button x:Name="AudioRetryButton" Grid.Column="2" Content="Restart audio" Margin="6,0,0,0" Padding="9,5"/></Grid>
              <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><ComboBox x:Name="RouteCombo" AutomationProperties.Name="Play through samples or Ableton"/><CheckBox x:Name="SoundToggle" Content="Drum sounds" Visibility="Collapsed"/><Grid Margin="0,8,0,0"><TextBlock Text="Master volume" Style="{StaticResource Muted}"/><TextBlock x:Name="VolumeValue" HorizontalAlignment="Right" Text="70%" Foreground="#C5F36B" FontSize="12"/></Grid><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="70" AutomationProperties.Name="Master volume"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="MIDI output" Style="{StaticResource Muted}" Margin="0,5,0,7"/><ComboBox x:Name="MidiCombo" AutomationProperties.Name="MIDI output"/><TextBlock x:Name="MidiStatus" Text="Optional · route to your DAW" Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
              </Grid>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Overall gain" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="OutputGainSlider" Grid.Column="1" Minimum="0" Maximum="18" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="Overall output gain" ToolTip="Boost all drum audio, including reverb. 0 dB is unchanged; overload protection remains active."/><TextBlock x:Name="OutputGainValue" Grid.Column="2" Text="+0.0 dB" Foreground="#C5F36B" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"/></Grid>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="ReverbToggle" Content="Reverb" VerticalAlignment="Center" ToolTip="Add room ambience to direct drum audio, including ASIO. MIDI stays unchanged."/><Slider x:Name="ReverbSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="16,0" VerticalAlignment="Center" AutomationProperties.Name="Reverb amount" ToolTip="Amount of stereo room ambience"/><TextBlock x:Name="ReverbValue" Grid.Column="2" Text="25%" Foreground="#C5F36B" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/></Grid>
            </StackPanel>
          </Border>
          <Border Background="#1B2018" BorderBrush="#39432D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0"><StackPanel><Grid><TextBlock Text="SENSITIVITY" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="HighSensitivity" Content="High" Padding="13,5" ToolTip="Softer strikes · 35 ms ringing guard · light crosstalk filtering"/><Button x:Name="MediumSensitivity" Content="Medium" Padding="13,5" Margin="6,0" ToolTip="Balanced · 70 ms ringing guard · moderate crosstalk filtering"/><Button x:Name="LowSensitivity" Content="Low" Padding="13,5" ToolTip="Harder strikes · 110 ms ringing guard · stronger crosstalk filtering"/></StackPanel></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Crosstalk protection" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="CrosstalkSlider" Grid.Column="1" Margin="14,0" Minimum="0" Maximum="70" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Crosstalk rejection percent" ToolTip="Reject nearby hits weaker than this percentage of the strongest peak. Higher can suppress soft simultaneous hits. Zero disables the 6 ms comparison window."/><TextBlock x:Name="TriggerStatus" Grid.Column="2" Text="0 extra triggers filtered" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></Grid></StackPanel></Border>
          <TextBlock x:Name="LastHit" Text="Ready when you are. Try the keys 1–8 to hear the kit." Style="{StaticResource Muted}" FontSize="11" Margin="2,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="2" Background="#1B2018" BorderBrush="#39432D" BorderThickness="1" CornerRadius="12" Padding="21,18">
          <StackPanel>
            <Grid><TextBlock Text="PAD SETTINGS" Style="{StaticResource Caption}"/><Button x:Name="AssignOneButton" Content="Assign input" HorizontalAlignment="Right" Padding="8,3" FontSize="10"/></Grid>
            <Grid Margin="0,9,0,3"><TextBlock x:Name="SelectedName" Text="Kick" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="SelectedInput" Text="A0 / 36" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/></Grid>
            <CheckBox x:Name="MuteToggle" Content="Mute this pad" Margin="0,5,0,10"/>
            <TextBlock Text="SOUND" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <ComboBox x:Name="SampleCombo" AutomationProperties.Name="Selected drum sample"/>
            <Grid Margin="0,4,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SampleCategoryHint" Text="Matching sounds only" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="BrowseSampleButton" Grid.Column="1" Content="Load WAV…" Padding="8,3" FontSize="10"/></Grid>
            <TextBlock x:Name="SampleStatus" Text="Synth fallback" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid><TextBlock Text="Trigger threshold" Style="{StaticResource Muted}"/><TextBlock x:Name="ThresholdValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid>
            <Slider x:Name="ThresholdSlider" Minimum="2" Maximum="1022" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Trigger threshold" ToolTip="Minimum sensor peak that triggers a hit. Lower is more sensitive."/>
            <Grid Margin="0,6,0,0"><TextBlock Text="Re-arm threshold" Style="{StaticResource Muted}"/><TextBlock x:Name="ResetValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid>
            <Slider x:Name="ResetSlider" Minimum="1" Maximum="39" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Re-arm threshold" ToolTip="Signal must fall below this value before the next hit. Kept below trigger threshold."/>
            <Grid Margin="0,6,0,0"><TextBlock Text="Velocity gain" Style="{StaticResource Muted}"/><TextBlock x:Name="GainValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid>
            <Slider x:Name="GainSlider" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Velocity gain"/>
            <Grid Margin="0,6,0,0"><TextBlock Text="Velocity floor" Style="{StaticResource Muted}"/><TextBlock x:Name="FloorValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid>
            <Slider x:Name="FloorSlider" Minimum="1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Velocity floor" ToolTip="Minimum output velocity, even for the softest hit."/>
            <Grid Margin="0,6,0,0"><TextBlock Text="Response curve" Style="{StaticResource Muted}"/><TextBlock x:Name="CurveValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid>
            <Slider x:Name="CurveSlider" Minimum="0.4" Maximum="2.5" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Response curve" ToolTip="1 is linear. Below 1 makes soft hits louder; above 1 gives more headroom."/>
            <Grid Margin="0,6,0,0"><TextBlock Text="Retrigger guard" Style="{StaticResource Muted}"/><TextBlock x:Name="GuardValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid>
            <Slider x:Name="GuardSlider" Minimum="0" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Retrigger guard" ToolTip="Ignore repeat hits from this pad for this many milliseconds. Set to 0 for fast rolls."/>
            <Expander Header="More MIDI controls" Foreground="#ADBCA5" FontSize="11" Margin="0,4,0,4"><StackPanel Margin="0,9,0,4"><Grid><TextBlock Text="Velocity maximum" Style="{StaticResource Muted}"/><TextBlock x:Name="CeilingValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid><Slider x:Name="CeilingSlider" Minimum="1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Maximum velocity"/><Grid Margin="0,6,0,0"><TextBlock Text="Note length (ms)" Style="{StaticResource Muted}"/><TextBlock x:Name="LengthValue" HorizontalAlignment="Right" Foreground="#C5F36B"/></Grid><Slider x:Name="LengthSlider" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="MIDI note length"/><TextBlock Text="Kit transpose" Style="{StaticResource Muted}" Margin="0,6,0,6"/><ComboBox x:Name="TransposeCombo" AutomationProperties.Name="Kit transpose"/></StackPanel></Expander>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MIDI note" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="NoteCombo" AutomationProperties.Name="Pad MIDI note"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Kit channel" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="ChannelCombo" AutomationProperties.Name="Kit MIDI channel"/></StackPanel></Grid>
            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="TestPad" Content="▶  Audition" Background="#C5F36B" Foreground="#1A2511"/><Button x:Name="ResetPad" Content="Reset" Grid.Column="2" ToolTip="Restore this pad to default settings"/></Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="3" BorderBrush="#293024" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,14,0,0">
        <StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="KitPresetCombo" Width="168" AutomationProperties.Name="Whole kit sound preset"/><Button x:Name="ApplyKitButton" Content="Apply sounds" Margin="6,0,0,0" Padding="10,6"/><Button x:Name="LibraryFolderButton" Content="Sample folder…" Margin="6,0,0,0" Padding="10,6"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SavePresetButton" Content="Save preset" Padding="10,6"/><Button x:Name="LoadPresetButton" Content="Load preset" Margin="6,0,0,0" Padding="10,6"/><Button x:Name="DefaultsButton" Content="Your defaults" Margin="6,0,0,0" Padding="10,6"/></StackPanel></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="USB DEVICE" Style="{StaticResource Caption}" Margin="0,0,0,7"/><ComboBox x:Name="PortCombo" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="USB device"/><TextBlock x:Name="SaveStatus" Text="Settings save automatically" Style="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><CheckBox x:Name="StartupToggle" Content="Launch with Windows"/><CheckBox x:Name="TrayToggle" Content="Keep playing in tray" ToolTip="Closing the window keeps Pulse running. Exit from the tray icon."/></StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center"><Button x:Name="PanicButton" Content="Silence all" ToolTip="Stop active audio and MIDI notes"/><Button x:Name="LogButton" Content="Diagnostics ↗" Background="Transparent" BorderThickness="0" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </Grid></StackPanel>
      </Border>
      <Border x:Name="LogPanel" Grid.Row="4" Visibility="Collapsed" Background="#171B15" CornerRadius="8" Margin="0,16,0,0" Padding="12"><StackPanel><TextBlock Text="DEVICE LOG" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="LogText" IsReadOnly="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A5B29B" BorderThickness="0" FontFamily="Consolas" FontSize="11"/><TextBlock Text="Busy port? Close Serial Monitor or the old drum app. No data? Hit a pad. Pulse expects NOTE,note,velocity then RAW,pad,peak at 115200 baud." TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
  </ScrollViewer>
</Window>
